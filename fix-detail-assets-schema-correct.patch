+
+enum DetailAssetKind {
+  PHOTO
+  NOTE
+  DXF
+}
+
+/// Fotos/nota en Project|Task; DXF en TaskMaterialLine.
+/// Binarios en Supabase (detail-assets); aquí solo metadatos.
+model DetailAsset {
+  id             String          @id @default(uuid())
+  kind           DetailAssetKind
+  storageKey     String?
+  publicUrl      String?
+  mimeType       String          @default("application/octet-stream")
+  sizeBytes      Int             @default(0)
+  originalName   String          @default("")
+  meta           Json?
+  sortOrder      Int             @default(0)
+  createdById    String
+  createdAt      DateTime        @default(now())
+  deletedAt      DateTime?
+
+  projectId      String?
+  taskId         String?
+  materialLineId String?
+
+  createdBy    User               @relation("DetailAssetCreatedBy", fields: [createdById], references: [id])
+  project      Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
+  task         Task?              @relation(fields: [taskId], references: [id], onDelete: Cascade)
+  materialLine TaskMaterialLine?  @relation(fields: [materialLineId], references: [id], onDelete: Cascade)
+
+  @@index([projectId])
+  @@index([taskId])
+  @@index([materialLineId])
+  @@index([kind, createdAt])
+}
