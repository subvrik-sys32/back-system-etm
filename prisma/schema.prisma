generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum JobLevel {
  GENERAL
  OPERARIO
  SUPERVISOR
}

// Área de trabajo dentro de un departamento (hoy: las 6 de
// Producción, una por ProcessCode). Deliberadamente NO es un enum
// fijo ni un alias de ProcessCode — vive en su propia tabla para
// que Ingeniería (o cualquier otro departamento futuro) pueda tener
// sus propias áreas sin necesitar otra migración. processCode queda
// nullable a propósito: solo las áreas de Producción lo usan hoy
// para filtrar WorkflowStep por proceso; las de otros departamentos
// (a futuro) simplemente no lo setean.
model Area {
  id          String       @id @default(uuid())
  code        String       @unique
  label       String
  processCode ProcessCode?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  users       User[]
}

model Role {
  id          String           @id @default(uuid())
  name        String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  active      Boolean          @default(true)
  code        String           @unique
  color       String
  icon        String
  permissions RolePermission[]
  // Antes lado inverso de la FK User.roleId (uno a muchos). Ahora
  // m2m implícito (ver User.roles) — Prisma resuelve la tabla de
  // unión sola con declarar el array en los dos lados.
  users       User[]
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
  userOverrides UserPermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Client {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String
  active    Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  color     String
  icon      String
  projects  Project[]
}

model User {
  id                     String         @id @default(uuid())
  name                   String
  email                  String         @unique
  passwordHash           String
  level                  JobLevel       @default(GENERAL)
  active                 Boolean        @default(true)
  deletedAt              DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  username               String?        @unique
  color                  String
  icon                   String
  avatarUrl              String?
  phone                  String?
  position               String?
  // "online" en sí sigue sin persistirse — se calcula en vivo desde
  // las conexiones SSE activas (ver RealtimeService.isUserOnline).
  // Esto es distinto: CUÁNDO fue la última vez que se desconectó
  // del todo (todas sus pestañas/conexiones cerradas), para poder
  // mostrar "visto por última vez hace X" cuando ya no está online.
  // Se actualiza en RealtimeService.disconnect() al perder la
  // última conexión activa.
  lastSeenAt             DateTime?
  auditLogs              AuditLog[]
  createdProjects        Project[]      @relation("ProjectCreatedBy")
  managedProjects        Project[]      @relation("ProjectPm")
  updatedProjects        Project[]      @relation("ProjectUpdatedBy")
  createdTasks           Task[]         @relation("TaskCreatedBy")
  updatedTasks           Task[]         @relation("TaskUpdatedBy")
  // Muchos a muchos — antes un roleId único (FK, un solo rol por
  // usuario). Ahora puede tener varios roles simultáneos (ej.
  // alguien que es INGENIERIA y PROYECTOS a la vez). Mismo patrón
  // m2m implícito que areas: sin tabla intermedia a mano, con
  // declarar Role[]/User[] en los dos lados alcanza. Un usuario
  // siempre tiene al menos un rol (se valida en el DTO/servicio,
  // no acá — Prisma no expresa "mínimo 1" en un m2m).
  roles                  Role[]
  // Overrides puntuales por usuario (ALLOW/DENY) por encima de los
  // permisos que ya le dan sus roles — ver UserPermission. Como
  // "grantedBy" también apunta a User, hace falta @relation con
  // nombre en los dos lados para desambiguar cuál FK es cuál.
  permissionOverrides    UserPermission[] @relation("UserPermissionOverrides")
  permissionOverridesGranted UserPermission[] @relation("UserPermissionGrantedBy")
  // Muchos a muchos — antes un OPERARIO tenía un solo área fija
  // (areaId). Ahora puede pertenecer a varias (ej. alguien que
  // rota entre Ingeniería y Producción). Relación m2m implícita de
  // Prisma: no hace falta tabla intermedia a mano, ni @relation acá
  // ni del lado de Area — con declarar Area[]/User[] en los dos
  // lados alcanza.
  areas                  Area[]
  workflowSteps          WorkflowStep[]
  workflowStepsAssigned  WorkflowStep[] @relation("WorkflowStepAssignedBy")
  workflowStepsInvited   WorkflowStep[] @relation("WorkflowStepInvitedOperator")
  workflowStepsInvitedBy WorkflowStep[] @relation("WorkflowStepInvitedBy")
  comments               Comment[]
  notificationsReceived  Notification[] @relation("NotificationRecipient")
  notificationsSent      Notification[] @relation("NotificationActor")
  activityLogs           ActivityLog[]
}

// ALLOW añade un permiso puntual que los roles del usuario no le
// dan; DENY se lo saca aunque alguno de sus roles sí lo incluya.
// DENY siempre gana sobre ALLOW si (por lo que sea) hubiera overrides
// contradictorios para el mismo permiso — ver AuthService donde se
// calculan los permisos efectivos. expiresAt es opcional: un override
// sin vencimiento queda indefinido hasta que alguien lo revoque a
// mano; con vencimiento, AuthService lo ignora solo (no hace falta
// un job que los borre).
enum PermissionEffect {
  ALLOW
  DENY
}

model UserPermission {
  id           String           @id @default(uuid())
  userId       String
  permissionId String
  effect       PermissionEffect
  // Por qué se otorgó/revocó este permiso puntual — queda en el
  // historial aunque el override se revoque después (no se borra
  // la fila al desactivar, ver `active` más abajo... en realidad no
  // hay `active`: revocar = delete directo, este `reason` es lo
  // único que explica el porqué mientras estuvo vigente).
  reason       String?
  expiresAt    DateTime?
  grantedById  String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  user         User             @relation("UserPermissionOverrides", fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedBy    User             @relation("UserPermissionGrantedBy", fields: [grantedById], references: [id])

  // Un mismo usuario no puede tener dos overrides activos para el
  // mismo permiso (ambigüedad: ¿cuál vale?) — para cambiarlo, se
  // borra el viejo y se crea uno nuevo, no se acumulan.
  @@unique([userId, permissionId])
  @@index([userId])
  @@index([expiresAt])
}

model Comment {
  id             String         @id @default(uuid())
  taskId         String?
  projectId      String?
  workflowStepId String?
  userId         String
  message        String
  imageUrl       String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  // Reply — null en un comentario de primer nivel. onDelete: SetNull
  // (no Cascade): si se borra el comentario padre, las respuestas NO
  // desaparecen con él, solo pierden la referencia (quedan como
  // comentarios sueltos) — Cascade acá borraría en cadena
  // conversaciones enteras por accidente.
  parentId       String?
  parent         Comment?       @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies        Comment[]      @relation("CommentReplies")
  task           Task?          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project        Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflowStep   WorkflowStep?  @relation(fields: [workflowStepId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id])
  notifications  Notification[]

  @@index([taskId])
  @@index([projectId])
  @@index([workflowStepId])
  @@index([parentId])
}

model Notification {
  id             String           @id @default(uuid())
  userId         String
  actorId        String
  type           NotificationType
  taskId         String?
  projectId      String?
  workflowStepId String?
  // Opcional: antes TODA notificación estaba atada a un comentario
  // (@relation obligatoria). Las de convocatoria/asignación
  // (TASK_ASSIGNED, TASK_SUMMONED) no nacen de un comentario, así
  // que este campo pasa a nullable — el resto de las notificaciones
  // existentes (MENTION, COMMENT) lo siguen llenando igual que antes.
  commentId      String?
  messageSnippet String
  read           Boolean          @default(false)
  createdAt      DateTime         @default(now())
  user           User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor          User             @relation("NotificationActor", fields: [actorId], references: [id])
  task           Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project        Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflowStep   WorkflowStep?    @relation(fields: [workflowStepId], references: [id], onDelete: Cascade)
  comment        Comment?         @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([commentId])
  @@index([userId, read, taskId])
  @@index([userId, read, workflowStepId])
  @@index([userId, read, projectId])
}

enum NotificationType {
  MENTION
  COMMENT
  // Asignación directa desde "Convocar" en TaskAreaPanel (modo
  // ASSIGN): el operatorId ya quedó puesto, no hace falta aceptar.
  TASK_ASSIGNED
  // Invitación desde "Convocar" (modo INVITE): el operatorId todavía
  // NO se tocó — el operario tiene que aceptar desde su "Mis tareas"
  // para que recién ahí se le asigne de verdad.
  TASK_SUMMONED
  // Respuesta del operario a una invitación (modo INVITE).
  // Destinatario: quien convocó (invitedById). Se crean en
  // acceptInvite / declineInvite — antes no existían y el
  // convocante no se enteraba de la respuesta.
  TASK_INVITE_ACCEPTED
  TASK_INVITE_DECLINED
}

model Priority {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String
  color     String
  active    Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  icon      String
  tasks     Task[]
}

model Material {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String
  active    Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  color     String
  icon      String
  tasks     Task[]
}

model Thickness {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String
  active    Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  color     String
  icon      String
  tasks     Task[]
}

model Color {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String
  active    Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  icon      String
  color     String
  tasks     Task[]
}

model Stage {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String
  active    Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  color     String
  icon      String
  projects  Project[]
}

model Status {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String
  active    Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  color     String
  icon      String
  projects  Project[]
}

model Project {
  id            String         @id @default(uuid())
  sequence      Int            @unique
  projectCode   String
  name          String
  clientId      String
  deliveryDate  DateTime? @db.Date
  position      Int            @default(0)
  createdById   String
  updatedById   String
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  pmId          String
  stageId       String
  statusId      String
  client        Client         @relation(fields: [clientId], references: [id])
  createdBy     User           @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  pm            User           @relation("ProjectPm", fields: [pmId], references: [id])
  stage         Stage          @relation(fields: [stageId], references: [id])
  status        Status         @relation(fields: [statusId], references: [id])
  updatedBy     User           @relation("ProjectUpdatedBy", fields: [updatedById], references: [id])
  tasks         Task[]
  comments      Comment[]
  activityLogs  ActivityLog[]
  notifications Notification[]

  @@index([clientId])
  @@index([pmId])
}

model Task {
  id            String         @id @default(uuid())
  taskNumber    Int            @unique
  projectId     String
  reference     String
  pieces        Int
  lotNumber     Int
  paintKg       Float
  priorityId    String
  materialId    String
  thicknessId   String
  colorId       String?
  plRt          String?
  deliveryDate  DateTime? @db.Date
  position      Int            @default(0)
  createdById   String
  updatedById   String
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  assemblyCount Int
  route         ProcessCode[]
  color         Color?         @relation(fields: [colorId], references: [id])
  createdBy     User           @relation("TaskCreatedBy", fields: [createdById], references: [id])
  material      Material       @relation(fields: [materialId], references: [id])
  priority      Priority       @relation(fields: [priorityId], references: [id])
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  thickness     Thickness      @relation(fields: [thicknessId], references: [id])
  updatedBy     User           @relation("TaskUpdatedBy", fields: [updatedById], references: [id])
  workflowSteps WorkflowStep[]
  comments      Comment[]
  activityLogs  ActivityLog[]
  notifications Notification[]
}

model WorkflowStep {
  id                String         @id @default(uuid())
  taskId            String
  processCode       ProcessCode
  status            WorkflowStatus
  order             Int
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  paintKgReal       Float?
  piecesOutput      Int?
  plRtReal          Float?
  reviewedAt        DateTime?
  operatorId        String?
  operator          User?          @relation(fields: [operatorId], references: [id])
  // Quién puso a `operator` ahí mediante "Convocar" (modo ASSIGN) —
  // null cuando el propio operario se autoasignó (flujo normal de
  // ProcessOperatorCell al iniciar). Es lo que separa "Asignadas" de
  // "Disponibles" en Mis tareas — no es lo mismo que operatorId, que
  // solo dice QUIÉN está puesto, no CÓMO llegó ahí.
  assignedById      String?
  assignedBy        User?          @relation("WorkflowStepAssignedBy", fields: [assignedById], references: [id])
  // "Convocar" modo INVITE: invitación pendiente, operatorId NO se
  // toca todavía. Se resuelve (acepta/rechaza) desde el propio "Mis
  // tareas" del operario invitado — recién al aceptar, invitedOperatorId
  // pasa a operatorId y assignedById se llena con invitedById.
  invitedOperatorId String?
  invitedOperator   User?          @relation("WorkflowStepInvitedOperator", fields: [invitedOperatorId], references: [id])
  invitedById       String?
  invitedBy         User?          @relation("WorkflowStepInvitedBy", fields: [invitedById], references: [id])
  invitedAt         DateTime?
  task              Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  comments          Comment[]
  notifications     Notification[]
  // Lista, no singular: antes ActivityLog.workflowStepId era
  // @unique a secas (un solo log por step), ahora es único por
  // (step, tipo) — así que un step puede tener hasta dos logs AUTO
  // acá (TASK_STARTED + TASK_COMPLETED).
  activityLogs      ActivityLog[]

  @@unique([taskId, processCode])
  @@index([taskId])
  @@index([invitedOperatorId])
}

enum EngineeringFileStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

model EngineeringFile {
  id           String                @id @default(cuid())
  originalName String
  filename     String
  extension    String
  mimeType     String
  size         Int
  status       EngineeringFileStatus @default(UPLOADING)
  metadata     Json?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  module    String
  entityId  String
  action    String
  oldValue  Json?
  newValue  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

enum ProcessCode {
  CT
  PL
  SD
  PT
  EN
  DS
}

enum WorkflowStatus {
  QUEUE
  PENDING
  PROGRESS
  PAUSED
  COMPLETED
  REVIEWED
}

enum DayShift {
  MORNING_1
  MORNING_2
  LUNCH
  AFTERNOON_1
  AFTERNOON_2
  NIGHT
}

// PRODUCCION: la bitácora actual (turnos, franjas, registro manual
// + automático al completar tareas). INGENIERIA: bitácora nueva,
// mismo motor, 100% manual, solo visible para ese equipo.
enum ActivityDepartment {
  PRODUCCION
  INGENIERIA
}

// MANUAL: lo registra la persona a mano (como siempre).
// AUTO: lo genera el sistema al completar un WorkflowStep — no
// pasa por la regla de franja horaria, es un registro aparte.
enum ActivityLogSource {
  MANUAL
  AUTO
}

model ActivityType {
  id         String             @id @default(uuid())
  code       String?            @unique
  label      String
  icon       String
  color      String
  order      Int                @default(0)
  active     Boolean            @default(true)
  // Data-driven: decide si el tipo va siempre visible como botón
  // directo en el picker o cae dentro de "Otros" — no hay ningún
  // code hardcodeado en el front para esto, se administra 100%
  // desde la pantalla de tipos de actividad.
  pinned     Boolean            @default(true)
  department ActivityDepartment @default(PRODUCCION)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  deletedAt  DateTime?
  logs       ActivityLog[]

  @@index([active])
  @@index([department])
}

model ActivityLog {
  id             String            @id @default(uuid())
  userId         String
  activityTypeId String
  projectId      String?
  taskId         String?
  // Solo se llena cuando source=AUTO — el WorkflowStep que disparó
  // este registro. Antes era @unique a secas (un solo log AUTO por
  // step); ahora que también se auto-registra el inicio (ver
  // ActivityLogService.createFromTaskStart), pasa a ser único por
  // (step, tipo) vía @@unique más abajo — como mucho un
  // TASK_STARTED y un TASK_COMPLETED por step, evitando duplicados
  // si el endpoint se llegara a invocar dos veces sobre el mismo.
  workflowStepId String?
  note           String?
  photoUrl       String?
  // Nullable: los registros AUTO no pertenecen a ninguna franja
  // horaria manual, no tiene sentido asignarles una.
  shift          DayShift?
  source         ActivityLogSource @default(MANUAL)
  loggedAt       DateTime          @default(now())
  createdAt      DateTime          @default(now())
  user           User              @relation(fields: [userId], references: [id])
  activityType   ActivityType      @relation(fields: [activityTypeId], references: [id])
  project        Project?          @relation(fields: [projectId], references: [id])
  task           Task?             @relation(fields: [taskId], references: [id])
  workflowStep   WorkflowStep?     @relation(fields: [workflowStepId], references: [id])

  @@unique([workflowStepId, activityTypeId])
  @@index([userId, loggedAt])
  @@index([projectId])
  @@index([taskId])
  @@index([source])
}