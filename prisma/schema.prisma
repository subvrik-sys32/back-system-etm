generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum JobLevel {
  GENERAL
  OPERARIO
  SUPERVISOR
}

// Área de trabajo dentro de un departamento (hoy: las 6 de
// Producción, una por ProcessCode). Deliberadamente NO es un enum
// fijo ni un alias de ProcessCode — vive en su propia tabla para
// que Ingeniería (o cualquier otro departamento futuro) pueda tener
// sus propias áreas sin necesitar otra migración. processCode queda
// nullable a propósito: solo las áreas de Producción lo usan hoy
// para filtrar WorkflowStep por proceso; las de otros departamentos
// (a futuro) simplemente no lo setean.
model Area {
  id          String       @id @default(uuid())
  code        String       @unique
  label       String
  processCode ProcessCode?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  users       User[]
}

model Role {
  id          String           @id @default(uuid())
  name        String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  active      Boolean          @default(true)
  code        String           @unique
  color       String
  icon        String
  permissions RolePermission[]
  users       User[]
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Client {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String
  active    Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  color     String
  icon      String
  projects  Project[]
}

model User {
  id                    String         @id @default(uuid())
  name                  String
  email                 String         @unique
  passwordHash          String
  roleId                String
  level                 JobLevel       @default(GENERAL)
  areaId                String?
  active                Boolean        @default(true)
  deletedAt             DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  username              String?        @unique
  color                 String
  icon                  String
  avatarUrl             String?
  phone                 String?
  position              String?
  auditLogs             AuditLog[]
  createdProjects       Project[]      @relation("ProjectCreatedBy")
  managedProjects       Project[]      @relation("ProjectPm")
  updatedProjects       Project[]      @relation("ProjectUpdatedBy")
  createdTasks          Task[]         @relation("TaskCreatedBy")
  updatedTasks          Task[]         @relation("TaskUpdatedBy")
  role                  Role           @relation(fields: [roleId], references: [id])
  area                  Area?          @relation(fields: [areaId], references: [id])
  workflowSteps         WorkflowStep[]
  comments              Comment[]
  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsSent     Notification[] @relation("NotificationActor")
  activityLogs          ActivityLog[]
}

model Comment {
  id             String         @id @default(uuid())
  taskId         String?
  projectId      String?
  workflowStepId String?
  userId         String
  message        String
  imageUrl       String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  task           Task?          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project        Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflowStep   WorkflowStep?  @relation(fields: [workflowStepId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id])
  notifications  Notification[]

  @@index([taskId])
  @@index([projectId])
  @@index([workflowStepId])
}

model Notification {
  id             String           @id @default(uuid())
  userId         String
  actorId        String
  type           NotificationType
  taskId         String?
  projectId      String?
  workflowStepId String?
  commentId      String
  messageSnippet String
  read           Boolean          @default(false)
  createdAt      DateTime         @default(now())
  user           User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor          User             @relation("NotificationActor", fields: [actorId], references: [id])
  task           Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project        Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflowStep   WorkflowStep?    @relation(fields: [workflowStepId], references: [id], onDelete: Cascade)
  comment        Comment          @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([commentId])
  @@index([userId, read, taskId])
  @@index([userId, read, workflowStepId])
  @@index([userId, read, projectId])
}

enum NotificationType {
  MENTION
  COMMENT
}

model Priority {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String
  color     String
  active    Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  icon      String
  tasks     Task[]
}

model Material {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String
  active    Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  color     String
  icon      String
  tasks     Task[]
}

model Thickness {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String
  active    Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  color     String
  icon      String
  tasks     Task[]
}

model Color {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String
  active    Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  icon      String
  color     String
  tasks     Task[]
}

model Stage {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String
  active    Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  color     String
  icon      String
  projects  Project[]
}

model Status {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String
  active    Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  color     String
  icon      String
  projects  Project[]
}

model Project {
  id            String         @id @default(uuid())
  sequence      Int            @unique
  projectCode   String
  name          String
  clientId      String
  deliveryDate  DateTime?
  position      Int            @default(0)
  createdById   String
  updatedById   String
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  pmId          String
  stageId       String
  statusId      String
  client        Client         @relation(fields: [clientId], references: [id])
  createdBy     User           @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  pm            User           @relation("ProjectPm", fields: [pmId], references: [id])
  stage         Stage          @relation(fields: [stageId], references: [id])
  status        Status         @relation(fields: [statusId], references: [id])
  updatedBy     User           @relation("ProjectUpdatedBy", fields: [updatedById], references: [id])
  tasks         Task[]
  comments      Comment[]
  activityLogs  ActivityLog[]
  notifications Notification[]

  @@index([clientId])
  @@index([pmId])
}

model Task {
  id            String         @id @default(uuid())
  taskNumber    Int            @unique
  projectId     String
  reference     String
  pieces        Int
  lotNumber     Int
  paintKg       Float
  priorityId    String
  materialId    String
  thicknessId   String
  colorId       String?
  plRt          String?
  deliveryDate  DateTime?
  position      Int            @default(0)
  createdById   String
  updatedById   String
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  assemblyCount Int
  route         ProcessCode[]
  color         Color?         @relation(fields: [colorId], references: [id])
  createdBy     User           @relation("TaskCreatedBy", fields: [createdById], references: [id])
  material      Material       @relation(fields: [materialId], references: [id])
  priority      Priority       @relation(fields: [priorityId], references: [id])
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  thickness     Thickness      @relation(fields: [thicknessId], references: [id])
  updatedBy     User           @relation("TaskUpdatedBy", fields: [updatedById], references: [id])
  workflowSteps WorkflowStep[]
  comments      Comment[]
  activityLogs  ActivityLog[]
  notifications Notification[]
}

model WorkflowStep {
  id            String         @id @default(uuid())
  taskId        String
  processCode   ProcessCode
  status        WorkflowStatus
  order         Int
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  paintKgReal   Float?
  piecesOutput  Int?
  plRtReal      Float?
  reviewedAt    DateTime?
  operatorId    String?
  operator      User?          @relation(fields: [operatorId], references: [id])
  task          Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  comments      Comment[]
  notifications Notification[]
  activityLog   ActivityLog?

  @@unique([taskId, processCode])
  @@index([taskId])
}

enum EngineeringFileStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

model EngineeringFile {
  id           String                @id @default(cuid())
  originalName String
  filename     String
  extension    String
  mimeType     String
  size         Int
  status       EngineeringFileStatus @default(UPLOADING)
  metadata     Json?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  module    String
  entityId  String
  action    String
  oldValue  Json?
  newValue  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

enum ProcessCode {
  CT
  PL
  SD
  PT
  EN
  DS
}

enum WorkflowStatus {
  QUEUE
  PENDING
  PROGRESS
  PAUSED
  COMPLETED
  REVIEWED
}

enum DayShift {
  MORNING_1
  MORNING_2
  LUNCH
  AFTERNOON_1
  AFTERNOON_2
  NIGHT
}

// PRODUCCION: la bitácora actual (turnos, franjas, registro manual
// + automático al completar tareas). INGENIERIA: bitácora nueva,
// mismo motor, 100% manual, solo visible para ese equipo.
enum ActivityDepartment {
  PRODUCCION
  INGENIERIA
}

// MANUAL: lo registra la persona a mano (como siempre).
// AUTO: lo genera el sistema al completar un WorkflowStep — no
// pasa por la regla de franja horaria, es un registro aparte.
enum ActivityLogSource {
  MANUAL
  AUTO
}

model ActivityType {
  id         String             @id @default(uuid())
  code       String?            @unique
  label      String
  icon       String
  color      String
  order      Int                @default(0)
  active     Boolean            @default(true)
  // Data-driven: decide si el tipo va siempre visible como botón
  // directo en el picker o cae dentro de "Otros" — no hay ningún
  // code hardcodeado en el front para esto, se administra 100%
  // desde la pantalla de tipos de actividad.
  pinned     Boolean            @default(true)
  department ActivityDepartment @default(PRODUCCION)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  deletedAt  DateTime?
  logs       ActivityLog[]

  @@index([active])
  @@index([department])
}

model ActivityLog {
  id             String            @id @default(uuid())
  userId         String
  activityTypeId String
  projectId      String?
  taskId         String?
  // Solo se llena cuando source=AUTO — el WorkflowStep que disparó
  // este registro. Constraint único: como mucho un log AUTO por
  // step (evita duplicados si WorkflowService.complete() se llegara
  // a invocar dos veces sobre el mismo step).
  workflowStepId String?           @unique
  note           String?
  photoUrl       String?
  // Nullable: los registros AUTO no pertenecen a ninguna franja
  // horaria manual, no tiene sentido asignarles una.
  shift          DayShift?
  source         ActivityLogSource @default(MANUAL)
  loggedAt       DateTime          @default(now())
  createdAt      DateTime          @default(now())
  user           User              @relation(fields: [userId], references: [id])
  activityType   ActivityType      @relation(fields: [activityTypeId], references: [id])
  project        Project?          @relation(fields: [projectId], references: [id])
  task           Task?             @relation(fields: [taskId], references: [id])
  workflowStep   WorkflowStep?     @relation(fields: [workflowStepId], references: [id])

  @@index([userId, loggedAt])
  @@index([projectId])
  @@index([taskId])
  @@index([source])
}
